rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'verde.psicologia@gmail.com' ||
        request.auth.token.email == 'dev@psicologovegano.com' ||
        request.auth.token.email == 'dev@psicologiavegana.com' ||
        request.auth.token.email == 'alanriverossaavedra@gmail.com'
      );
    }

    // Portadas e imágenes públicas
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Recursos privados (audioguías MP3, cuadernillos PDF)
    match /private_assets/{allPaths=**} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}
