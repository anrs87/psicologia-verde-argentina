{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "originales/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": "sitemap"
      },
      {
        "source": "/admin/editor",
        "destination": "/admin.html"
      },
      {
        "source": "/portal",
        "destination": "/portal/index.html"
      },
      {
        "source": "/portal/**",
        "destination": "/portal/index.html"
      },
      {
        "source": "/articulos/**",
        "function": "serveArticlePreview"
      },
      {
        "source": "/articulo.html",
        "destination": "/articulo.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}
