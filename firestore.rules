rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura pública a cualquier artículo, pero solo el administrador puede escribir
    match /articulos/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /testimonios/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /faqs/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /registro_visitas/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }

    // Ecosistema Tienda Digital & Audioguías
    match /products/{productId} {
      allow read: if resource.data.estado == 'publicado' || 
                  (request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com');
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'verde.psicologia@gmail.com');
      // El usuario puede crear/actualizar sus datos de perfil (nombre, etc.), pero la inyección de productos adquiridos la realiza el Admin SDK en Cloud Functions
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productos_adquiridos']);
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
                  (resource.data.uid_usuario == request.auth.uid || request.auth.token.email == 'verde.psicologia@gmail.com');
      // Las transacciones solo se crean y actualizan a través del Admin SDK en Cloud Functions
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
  }
}
