rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'verde.psicologia@gmail.com' ||
        request.auth.token.email == 'dev@psicologovegano.com' ||
        request.auth.token.email == 'dev@psicologiavegana.com' ||
        request.auth.token.email == 'alanriverossaavedra@gmail.com'
      );
    }

    // Permitir lectura pública a cualquier artículo, pero solo el administrador puede escribir
    match /articulos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonios/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /registro_visitas/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Ecosistema Tienda Digital & Audioguías
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId &&
                    (!('productos_adquiridos' in request.resource.data) || request.resource.data.productos_adquiridos.size() == 0);
      allow update: if request.auth != null && request.auth.uid == userId && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productos_adquiridos']);
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && 
                  (resource.data.uid_usuario == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if request.auth != null && 
                  (resource.data.uid_usuario == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /pending_emails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
