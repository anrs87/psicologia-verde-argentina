rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura pública a cualquier artículo, pero solo el administrador puede escribir
    match /articulos/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /testimonios/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /faqs/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
    match /registro_visitas/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'verde.psicologia@gmail.com';
    }
  }
}
